// Goto/label statements
function testForwardGoto() {
  temp.result = 0;
  goto skip;
  temp.result = 999;
  skip:
  temp.result = 1;
}

function testBackwardGoto() {
  temp.i = 0;
  temp.sum = 0;
  loopTop:
  temp.sum += temp.i;
  temp.i++;
  if (temp.i < 5) goto loopTop;
}

function testGotoIntoNestedBlock() {
  temp.flag = true;
  if (temp.flag) {
    goto inner;
  }
  temp.result = 0;
  if (temp.flag) {
    inner:
    temp.result = 1;
  }
}
