//#CLIENTSIDE
if (created) {
  set bombready;
  unset bombready;
  playerbombs--;
  playerx=playery;
  playerdir=0;
}
if(this.bomb=2&&this.charge>=2) putbomb 2,x,y;
if(havebomblvl3&&this.bomb=1) setimg wbomb3.png;
if(strequals(#w,*Bomb)) hidelocal;
function resetimg() {
  setimg wbomb2.png;
  setimg wbomb2d.png;
  setimg wbomb3.png;
  setimg wbomb1.png;
  setimg wbomb3d.png;
  setimg wbomb1d.png;
}
function nextimg() { resetimg(); }
