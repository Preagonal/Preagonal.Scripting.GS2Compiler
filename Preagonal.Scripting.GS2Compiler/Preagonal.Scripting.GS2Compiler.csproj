<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <LangVersion>latest</LangVersion>
        <Title>GS2Compiler</Title>
        <Authors>Preagonal</Authors>
        <Copyright>Preagonal 2026</Copyright>
        <PackageProjectUrl>https://github.com/Preagonal/Preagonal.Scripting.GS2Compiler</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Preagonal/Preagonal.Scripting.GS2Compiler</RepositoryUrl>
        <PackageId>Preagonal.Scripting.GS2Compiler</PackageId>
        <Description>GS2 compiler compatible with Preagonal.Scripting.GS2Engine.</Description>
        <PackageTags>gs2;graal;compiler;preagonal</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
        <TargetFramework>net10.0</TargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Local Common development: set the PreagonalCommonRoot environment variable to your
             Preagonal.Scripting.Common checkout (e.g. export PreagonalCommonRoot=$HOME/gs2-common-migrate/)
             to build the compiler against live Common source. When unset, the default sibling
             checkout path is probed; if neither exists, the pinned NuGet package below is used. -->
        <PreagonalCommonRoot Condition="'$(PreagonalCommonRoot)' == ''">$(MSBuildThisFileDirectory)..\..\Preagonal.Scripting.Common\</PreagonalCommonRoot>
    </PropertyGroup>
    <Choose>
        <When Condition="Exists('$(PreagonalCommonRoot)src/Preagonal.Scripting.Common/Preagonal.Scripting.Common.csproj')">
            <ItemGroup>
                <ProjectReference Include="$(PreagonalCommonRoot)src/Preagonal.Scripting.Common/Preagonal.Scripting.Common.csproj" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <PackageReference Include="Preagonal.Scripting.Common" Version="1.4.95" />
            </ItemGroup>
        </Otherwise>
    </Choose>

    <ItemGroup>
        <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>