<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="StuDev.AotAnywhere" Version="1.1.0" />

    <ItemGroup>
        <ProjectReference Include="..\Preagonal.Scripting.GS2Compiler\Preagonal.Scripting.GS2Compiler.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../include/**/*.h"
              Link="include/%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <AssemblyName>gs2compiler</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PublishAot>true</PublishAot>
        <NativeLib>Shared</NativeLib>
        <SelfContained>true</SelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

</Project>